DOG_TRAINING_RAG_APP_NAME=dog-training-rag
DOG_TRAINING_RAG_ENVIRONMENT=local
DOG_TRAINING_RAG_LOG_LEVEL=INFO
DOG_TRAINING_RAG_CORS_ORIGINS=["http://localhost:3000"]

# 검색 설정 (선택)
# DOG_TRAINING_RAG_QDRANT_PATH=data/qdrant
# DOG_TRAINING_RAG_QDRANT_COLLECTION=evidence_cards_v1
# DOG_TRAINING_RAG_SCOPE_MATCHED_MINIMUM_SCORE=0.40

# 아래 generation 설정은 기본 실행에 필요하지 않습니다.
# /chat은 승인된 EvidenceCard의 claim을 결정적으로 조립해 답변하며
# generation provider를 초기화하거나 호출하지 않습니다 (docs/answer-composition.md).
# backend/app/generation.py는 5G 모델 비교 실험용으로 보존된 코드이고
# production 경로에서는 사용하지 않습니다. 아래 값을 채워도 /chat 동작은 달라지지 않습니다.
# GENERATION_BASE_URL=
# GENERATION_API_KEY=
# GENERATION_MODEL=
